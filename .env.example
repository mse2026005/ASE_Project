# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shg_credit_manager
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shg_credit_manager
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/shg_credit_manager

# Security & JWT
JWT_SECRET_KEY=change_me_super_secret_key_for_development_jwt_auth_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# App Configuration
ENV=development
PROJECT_NAME="SHG Credit Manager"
ENABLE_IN_PROCESS_SCHEDULER=false

